{
  "schema_version": 1,
  "machine_id": "local-agent-mcp",
  "listen": {
    "host": "127.0.0.1",
    "port": 18879
  },
  "existing_tunnel": {
    "id": "",
    "api_key": "",
    "old_target": "http://127.0.0.1:8787/mcp"
  },
  "callers": [
    {
      "id": "chatgpt",
      "level": "L1",
      "token": "REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS"
    },
    {
      "id": "dsh",
      "level": "L1",
      "token": "REPLACE_WITH_A_DIFFERENT_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS"
    }
  ],
  "host_read_roots": {},
  "host_write_roots": {},
  "containers": [
    {
      "name": "CONTAINER_NAME",
      "opencode": {
        "enabled": false,
        "binary": "/tmp/agent-mcp-bin/opencode-2.1.2",
        "port": 4101,
        "cwd": "/workspace/project",
        "state_root": "/tmp/agent-mcp-opencode-CONTAINER_NAME",
        "container_id": "CONTAINER_ID",
        "max_concurrent": 3
      }
    }
  ],
  "advisor_mcp": {
    "enabled": false,
    "listen": {
      "host": "127.0.0.1",
      "port": 8787,
      "path": "/mcp"
    },
    "gateway_caller": "chatgpt",
    "roots": {},
    "write_roots": [],
    "file_operations": [
      "list_files",
      "read_file",
      "file_info",
      "search_files",
      "search_text",
      "git_summary"
    ],
    "gateway_tools": [
      "gateway_status",
      "opencode_status",
      "opencode_diff"
    ]
  },
  "tunnel_client": {
    "enabled": false,
    "binary": "../components/tunnel-client/runtime/tunnel-client-runtime-cloudflared",
    "health_addr": "127.0.0.1:38433",
    "target_url": "http://127.0.0.1:8787/mcp"
  },
  "agents": {
    "state_file": "~/.local/state/agent-mcp/native-agent-state.json",
    "host_scopes_file": "~/.local/state/agent-mcp/host-scopes.json",
    "host_backends": {},
    "backends": {}
  },
  "opencode_host": {
    "enabled": false
  },
  "audit": "~/.local/state/agent-mcp/audit.jsonl",
  "permissions": {
    "l1": "current",
    "l2": "full"
  },
  "runtime": {
    "version": "2.1.2",
    "plugins": [],
    "host": {
      "enabled": false,
      "binary": "/home/kevin/.opencode/bin/opencode",
      "port": 4100,
      "cwd": "/home/kevin/workspace/project",
      "max_concurrent": 3
    }
  },
  "opencode_config": "~/.config/opencode/opencode.jsonc"
}
