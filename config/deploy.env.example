# 本机专属配置：由 scripts/install.sh 首次安装时复制至
# ~/.config/personal-mcp-server/deploy.env。不要提交本机配置。
MCP_PORT=18878
MCP_LAN_PORT=18879
# S100 旧插件保留 s100；迁移新设备时可以改为 lap1、server1 等
MCP_TOOL_PREFIX=s100

OPENCODE_VERSION=2.0.32
OPENCODE_HOST=127.0.0.1
OPENCODE_PORT=4096
# 可选：若已有官方 OpenCode v2 程序，填写它的绝对路径
OPENCODE_CLI_BIN=

# 与 S100 当前运行版本一致；更换版本时使用官方 release
TUNNEL_VERSION=v0.0.14
# 该 ID 属于设备专属配置，不能从其他运行中的主机直接重复使用
CHATGPT_TUNNEL_ID=
TUNNEL_HEALTH_PORT=38437
# 可选：填写已安装的 tunnel-client-runtime-cloudflared 可执行程序路径
TUNNEL_CLIENT_BIN=
