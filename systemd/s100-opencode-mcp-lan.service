[Unit]
Description=S100-1 OpenCode Shell MCP (LAN, token-authenticated)
After=network-online.target s100-opencode-server.service
Wants=s100-opencode-server.service

[Service]
Type=simple
WorkingDirectory=/home/sunrise/.local/share/opencode-mcp
Environment=PATH=/home/sunrise/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=S100_MCP_HOST=0.0.0.0
Environment=S100_MCP_PORT=18879
Environment=S100_MCP_TOKEN_FILE=/home/sunrise/.local/share/opencode-mcp/runtime/access-token
ExecStart=/home/sunrise/.local/bin/node /home/sunrise/.local/share/opencode-mcp/src/server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
KillMode=control-group

[Install]
WantedBy=default.target
