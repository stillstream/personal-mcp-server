[Unit]
Description=Personal MCP Server (LAN, token authentication)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/opencode-mcp
ExecStart=/bin/bash %h/.local/share/opencode-mcp/bin/run-mcp.sh lan
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
KillMode=control-group

[Install]
WantedBy=default.target
